
package com.company.bookhub.ai.service;

import com.company.bookhub.ai.dto.AiChatResponse;
import org.springframework.ai.chat.client.ChatClient;
import org.springframework.ai.chat.client.advisor.MessageChatMemoryAdvisor;
import org.springframework.ai.chat.memory.ChatMemory;
import org.springframework.ai.document.Document;
import org.springframework.ai.vectorstore.SearchRequest;
import org.springframework.ai.vectorstore.VectorStore;
import org.springframework.stereotype.Service;

import java.nio.charset.StandardCharsets;
import java.util.List;
import java.util.UUID;
import java.util.stream.Collectors;

@Service
public class AiChatService {

    private final ChatClient chatClient;
    private final VectorStore vectorStore;

    public AiChatService(
            ChatClient.Builder chatClientBuilder,
            ChatMemory chatMemory,
            VectorStore vectorStore
    ) {

        this.vectorStore = vectorStore;

        this.chatClient = chatClientBuilder
                .defaultSystem("""
                        You are BookHub AI Assistant.

                        You help users with questions about:
                        - Books and reading.
                        - Authors and literature.
                        - Book recommendations.
                        - General educational questions.

                        Be friendly, clear, and concise.

                        Important:
                        - Use retrieved BookHub context when answering
                          questions about actual books, authors, and categories
                          in the BookHub database.
                        - Never invent BookHub inventory information.
                        - If the retrieved context does not contain the
                          requested catalog information, clearly say so.
                        - You may still answer general educational questions
                          using your general knowledge.
                        - Do not claim to have performed an action in BookHub.
                        """)
                .defaultAdvisors(
                        MessageChatMemoryAdvisor.builder(chatMemory).build()
                )
                .build();
    }

    public AiChatResponse chat(
            String message,
            String conversationId,
            String username
    ) {

        String scopedConversationId = UUID.nameUUIDFromBytes(
                (username + ":" + conversationId)
                        .getBytes(StandardCharsets.UTF_8)
        ).toString();

        // Step 1: Retrieve relevant BookHub records.
        List<Document> relevantDocuments = vectorStore.similaritySearch(
                SearchRequest.builder()
                        .query(message)
                        .topK(4)
                        .similarityThresholdAll()
                        .build()
        );

        // Step 2: Combine retrieved records into context.
        String context = relevantDocuments.stream()
                .map(Document::getText)
                .collect(Collectors.joining("\n\n---\n\n"));

        // Step 3: Build a prompt containing the retrieved context.
        String userPrompt = """
                Use the following retrieved BookHub database information
                to answer questions about books, authors, and categories.

                If the information is not available in the context,
                clearly explain that you could not find it in BookHub's catalog.
                Do not invent catalog details.

                Retrieved BookHub context:
                %s

                User question:
                %s
                """.formatted(
                context.isBlank()
                        ? "No relevant BookHub records were found."
                        : context,
                message
        );

        // Step 4: Generate the answer while preserving chat memory.
        String response = chatClient
                .prompt()
                .user(userPrompt)
                .advisors(advisor -> advisor.param(
                        ChatMemory.CONVERSATION_ID,
                        scopedConversationId
                ))
                .call()
                .content();

        return new AiChatResponse(response);
    }
}

